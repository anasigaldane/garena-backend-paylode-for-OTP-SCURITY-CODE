# Firebase Configuration
# Remplacez par vos vraies valeurs (NE PAS COMMITER .env)
FIREBASE_API_KEY=your_api_key_here
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_DATABASE_URL=https://your_project-default-rtdb.firebaseio.com
FIREBASE_STORAGE_BUCKET=your_project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# CORS (optionnel, déjà configuré par défaut pour Vercel)
# CORS_ALLOWED_ORIGINS=https://garena-account-verify.vercel.app

# Port (Render/Railway/etc. injectent PORT automatiquement)
# PORT=8000
